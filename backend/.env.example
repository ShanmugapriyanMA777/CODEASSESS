# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Default is SQLite for zero-config local run, switch to Postgres/Supabase for production)
DATABASE_URL="file:./dev.db"
# For Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Security & Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Code Execution Engine
CODE_EXECUTION_MODE="sandbox" # "sandbox" | "docker"
CODE_EXECUTION_TIMEOUT_MS=5000
REDIS_URL="redis://localhost:6379"
